# Proxy identity: development trusts no proxy. Production refuses startup until
# this is set to the VERIFIED ALB subnet CIDRs (comma-separated; no wildcard).
# Do not copy an invented VPC range. Restrict task ingress to the ALB security
# group. Verify ALB X-Forwarded-For mode=append and client-port inclusion=false.
# Deployment gate: supply the actual trusted subnet CIDRs in ECS environment or
# secrets before the migration task and API can start with APP_ENV=production.
# Docker/ECS disables Uvicorn proxy parsing; the app owns this trust boundary.
TRUSTED_PROXY_CIDRS=

# Database: Postgres only. Required.
APP_ENV=development
# Set APP_ENV=production in deployed environments; insecure cookies, weak JWT
# secrets, and non-HTTPS/empty CORS origins then fail startup validation.
# Local: postgresql+asyncpg://cooking:cooking@127.0.0.1:5432/cooking
# Docker: postgresql+asyncpg://cooking:cooking@postgres:5432/cooking
DATABASE_URL=postgresql+asyncpg://cooking:cooking@127.0.0.1:5432/cooking

# AWS RDS and some managed Postgres require TLS. Set true when the server expects SSL.
# DATABASE_SSL=true
# DATABASE_CA_FILE=/run/secrets/verified-rds-ca.pem
# Pool budget includes API/worker replicas, rollout overlap and an admin reserve.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
DB_CONNECTION_BUDGET=60
DB_ADMIN_CONNECTION_RESERVE=10
DB_MAX_API_REPLICAS=2
DB_MAX_WORKER_REPLICAS=1
DB_PROCESSES_PER_TASK=1
DB_DEPLOYMENT_SURGE_FACTOR=2

# Auth: long random string for JWT signing (e.g. openssl rand -hex 32). Required for /auth/register and /auth/login.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional Google sign-in: Web OAuth client ID from your Google Cloud project.
# Register every exact web origin in Google Cloud. No client secret is used.
# Leave empty to disable the Google button.
GOOGLE_CLIENT_ID=

# CORS: comma-separated origins (e.g. frontend URL). Do not use * with credentials.
# Dev: http://localhost:3000,http://127.0.0.1:3000
# Prod (cross-origin): https://cook-lake-alpha.vercel.app
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production uses secure cookies. HTTPS sibling subdomains can use SameSite=lax;
# unrelated preview domains require SameSite=none plus Secure.
# COOKIE_SAMESITE=none requires COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# OpenAI API key for recipe extraction and shopping-list refine (LLM).
# Without this, text extraction reports unavailable; optional video analysis is
# configured separately below. Shopping/timing have local fallbacks.
# Use a company-controlled project/service account for production, separate from dev.
OPENAI_API_KEY=
OPENAI_PROJECT=
# Luna text calls use Standard processing and no reasoning initially.
# AI_PRICE_MODEL and reviewed rates must match before paid calls are enabled.
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=35
OPENAI_MAX_OUTPUT_TOKENS=4000
# Complete shopping lists need more output than one recipe.
OPENAI_SHOPPING_MAX_OUTPUT_TOKENS=20000
# Optional audiovisual fallback. No key or reviewed pricing = disabled. Shares
# the same $30 hard monthly ledger and two-generation-call operation cap below.
# Secrets stay server-side. This configuration does not create a paid account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_PRICE_MODEL=
GEMINI_PRICE_VERSION=
# Reviewed 2026-09-24 at https://ai.google.dev/gemini-api/docs/pricing:
# Standard tier input (including audio/video) >=0.30, output incl thinking >=2.50.
# GEMINI_INPUT_USD_PER_MILLION_TOKENS=0.30
# GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=2.50
GEMINI_TIMEOUT_SECONDS=35
GEMINI_MAX_OUTPUT_TOKENS=8000
# Public canonical YouTube URLs or inline MP4/MOV/WebM/MP3/M4A/WAV/FLAC up to 30 MiB.
# Base64 payload is at most 40 MiB; multipart upload envelope is capped at 31 MiB.
# Each call reserves the reviewed model's full 1,048,576 input/65,536 output
# token bounds ($0.4784128 at these rates), counts tokens before generation, then
# reconciles actual usage. Unknown charged usage retains the whole reservation.
# Accepted AI operations, shared across processes via PostgreSQL. Import can use
# up to two bounded calls. Failed admitted operations still consume an allowance.
# These are request caps, not dollar budgets. Set provider spend limits separately.
AI_USER_REQUESTS_PER_MINUTE=6
AI_USER_REQUESTS_PER_DAY=50
AI_GLOBAL_REQUESTS_PER_MINUTE=60
AI_GLOBAL_REQUESTS_PER_DAY=1000

# Historical hosting-planning fields only; these no longer constrain AI admission
# or represent a newly agreed total bill. No app setting controls AWS/Vercel bills.
OPERATING_MONTHLY_BUDGET_USD=150
HOSTING_MONTHLY_RESERVE_USD=150
# Paid calls fail closed at zero. The app's hard monetary maximum is $30 per UTC
# month; allocations above 30 are rejected, independently of hosting. For explicit
# beta enablement use .env.beta.example ($29 app/$3 account, verified model rates).
# Covers only this app's modeled API calls, excluding taxes and other key usage.
AI_MONTHLY_BUDGET_USD=0
AI_ACCOUNT_MONTHLY_BUDGET_USD=0
AI_PRICE_VERSION=
AI_PRICE_MODEL=
# AI_INPUT_USD_PER_MILLION_TOKENS=
# AI_OUTPUT_USD_PER_MILLION_TOKENS=
AI_GLOBAL_MAX_INFLIGHT=4
AI_USER_MAX_INFLIGHT=1
AI_OPERATION_TIMEOUT_SECONDS=85

# Production resolves auto to durable and requires a separate Linux worker using
# the same image: python -m app.jobs.worker. Run migrations first: python -m app.migrate.
STORE_JOBS_MODE=auto
STORE_JOBS_ENABLED=true
STORE_JOBS_QUEUE_MAX=100
STORE_JOBS_POLL_SECONDS=2
STORE_JOBS_WAIT_SECONDS=25
STORE_JOBS_TIMEOUT_SECONDS=125
STORE_JOBS_LEASE_SECONDS=180
STORE_JOBS_MAX_ATTEMPTS=2
STORE_JOBS_RETRY_SECONDS=5
STORE_JOBS_WARM_INTERVAL_SECONDS=86400
STORE_JOBS_RETENTION_SECONDS=86400
# Shared across all API replicas, including cache hits and batches. Excess returns
# 429/Retry-After. HTTP timeout never cancels a shared durable scraper job.
STORE_REQUEST_GLOBAL_PER_MINUTE=120
STORE_REQUEST_ACCOUNT_PER_MINUTE=30
STORE_REQUEST_GLOBAL_MAX_INFLIGHT=12
STORE_REQUEST_ACCOUNT_MAX_INFLIGHT=2
STORE_REQUEST_TIMEOUT_SECONDS=30
# /store-products/batch accepts at most 100 strings, each at most 512 characters.

# Shared DB-backed auth/upload admission. Defaults on outside APP_ENV=test.
AUTH_GLOBAL_PER_MINUTE=120
AUTH_LOGIN_IP_PER_MINUTE=60
AUTH_LOGIN_ACCOUNT_PER_MINUTE=10
AUTH_REGISTER_IP_PER_HOUR=20
AUTH_REGISTER_ACCOUNT_PER_HOUR=5
UPLOAD_GLOBAL_PER_MINUTE=120
UPLOAD_ACCOUNT_PER_HOUR=30
UPLOAD_ACCOUNT_BYTES_PER_DAY=52428800
# Cumulative reservations: no automatic daily/monthly reset or failed-write refund.
# Historical objects need a verified inventory baseline before full-bucket claims.
UPLOAD_GLOBAL_TOTAL_COUNT=10000
UPLOAD_GLOBAL_TOTAL_BYTES=5368709120
UPLOAD_ACCOUNT_TOTAL_COUNT=200
UPLOAD_ACCOUNT_TOTAL_BYTES=104857600

# Optional Instacart shopping links. Keep this key on the backend only.
# Obtain a development key first; production keys need Instacart approval.
INSTACART_API_KEY=
INSTACART_ENVIRONMENT=development

# Recipe image uploads: leave both empty for local dev (files saved under ./uploads, served at /uploads/...).
# Set both for backend-validated S3 uploads in production (10 MB per image).
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-bucket-name

# Optional override for local disk uploads (default: ./uploads relative to backend cwd).
# LOCAL_IMAGE_UPLOAD_DIR=uploads

# Explicit comma-separated account UUIDs from your own verified users table.
# Empty denies access. Email addresses no longer grant administrative privileges.
ADMIN_USER_IDS=
PUBLIC_LIBRARY_EDITOR_USER_IDS=


# AI recipe covers: one preview at a time, saved only when the user applies it.
# Enabled when this flag is true AND OPENAI_API_KEY is configured.
# registered: every signed-in account; members: active server-side feature grant.
AI_IMAGE_GENERATION_ENABLED=true
AI_IMAGE_ACCESS_MODE=registered
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_TIMEOUT_SECONDS=45
AI_IMAGE_USER_REQUESTS_PER_MINUTE=1
AI_IMAGE_USER_REQUESTS_PER_DAY=3
AI_IMAGE_ADMIN_REQUESTS_PER_DAY=100
AI_IMAGE_GLOBAL_REQUESTS_PER_MINUTE=10
AI_IMAGE_GLOBAL_REQUESTS_PER_DAY=100

# Retained for compatibility with existing deployment settings.
PUBLIC_API_ORIGIN=
