# Explicit beta AI overlay. Apply to the reviewed release environment only after
# confirming the separate company-controlled OpenAI project/key and billing.
# Contains no credentials and does not change hosting or activate a retailer.
# App allowance: $29 per UTC calendar month, preserving $1 below the hard $30
# maximum. Per-account allowance: $3; unknown provider outcomes stay reserved.
# This is modeled app usage, not an invoice/tax/other-API-key-consumer ceiling.
AI_MONTHLY_BUDGET_USD=29
AI_ACCOUNT_MONTHLY_BUDGET_USD=3
OPENAI_MODEL=gpt-6-luna
AI_PRICE_MODEL=gpt-6-luna
AI_PRICE_VERSION=openai-gpt-6-luna-standard-cache-bound-2026-09-29
# https://developers.openai.com/api/docs/models/gpt-6-luna
# Official Standard prices verified 2026-09-29, USD per 1M tokens: uncached input
# 0.10, cache writes 0.125, cached input 0.01, output (including reasoning) 0.50.
# The ledger conservatively counts all input at the cache-write price, so its
# estimate can exceed actual charges. Calls explicitly use Standard processing,
# no reasoning, no tools, and reject input bounds over 272K to avoid higher tiers.
# Reverify after provider price/model changes. To roll back to gpt-4o-mini, update
# OPENAI_MODEL, AI_PRICE_MODEL and AI_PRICE_VERSION together and use 0.15/0.60.
AI_INPUT_USD_PER_MILLION_TOKENS=0.125
AI_OUTPUT_USD_PER_MILLION_TOKENS=0.50
OPENAI_MAX_OUTPUT_TOKENS=4000
# Complete shopping lists need more output than one recipe.
OPENAI_SHOPPING_MAX_OUTPUT_TOKENS=20000
OPENAI_TIMEOUT_SECONDS=35
AI_GLOBAL_MAX_INFLIGHT=4
AI_USER_MAX_INFLIGHT=1
AI_OPERATION_TIMEOUT_SECONDS=85
