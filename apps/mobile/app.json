{
  "expo": {
    "name": "Chef World",
    "slug": "cooking-mobile",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "cooking",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chefworld.cooking",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chefworld.cooking",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF8F2"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Chef World needs access to your photos so you can attach a recipe cover image."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "34e453ca-5d4b-408a-881e-7c82b3c9d2d1"
      }
    },
    "owner": "1945174310"
  }
}
